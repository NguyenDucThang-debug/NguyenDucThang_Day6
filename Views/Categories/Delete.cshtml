@model NguyenDucThang_Day6.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-modern p-4 border-danger">
            <div class="border-bottom pb-3 mb-3">
                <h4 class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa danh mục</h4>
                <p class="text-muted small mb-0">Bạn có chắc chắn muốn xóa danh mục này không?</p>
            </div>
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Name)</dd>
            </dl>
            <form asp-action="Delete" class="d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-light border px-4">
                    <i class="bi bi-arrow-left me-1"></i> Hủy
                </a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                </button>
            </form>
        </div>
    </div>
</div>
