@model NguyenDucThang_Day6.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-modern p-4">
            <div class="border-bottom pb-3 mb-4">
                <h4 class="fw-bold text-warning mb-1"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa danh mục</h4>
                <p class="text-muted small mb-0">Cập nhật tên danh mục sách</p>
            </div>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning px-4 shadow-sm fw-semibold">
                        <i class="bi bi-save me-1"></i> Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
