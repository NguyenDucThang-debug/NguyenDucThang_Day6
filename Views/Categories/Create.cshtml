@model NguyenDucThang_Day6.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-modern p-4">
            <div class="border-bottom pb-3 mb-4">
                <h4 class="fw-bold text-success mb-1"><i class="bi bi-plus-square-fill me-2"></i>Thêm danh mục mới</h4>
                <p class="text-muted small mb-0">Nhập tên danh mục sách mới vào hệ thống</p>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Công nghệ thông tin, Văn học..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Lưu danh mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
