@model IEnumerable<NguyenDucThang_Day6.Models.Book>

@{
    ViewData["Title"] = "Danh sách Sách";
}

<div class="card card-modern p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-journal-bookmark-fill text-success me-2"></i>Danh sách Sách</h3>
            <p class="text-muted small mb-0">Quản lý thông tin đầu sách, tác giả, ngày xuất bản và danh mục</p>
        </div>
        <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.Author)</th>
                    <th>@Html.DisplayNameFor(model => model.PublishDate)</th>
                    <th>@Html.DisplayNameFor(model => model.PageCount)</th>
                    <th>@Html.DisplayNameFor(model => model.Category)</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>
                            <i class="bi bi-person text-muted me-1"></i>
                            @Html.DisplayFor(modelItem => item.Author)
                        </td>
                        <td>
                            <i class="bi bi-calendar3 text-muted me-1"></i>
                            @item.PublishDate.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-file-earmark-text me-1"></i>@item.PageCount trang
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                @Html.DisplayFor(modelItem => item.Category.Name)
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-semibold me-1">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-semibold me-1">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-semibold">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
